# Name shown across the site. Do a trademark search (e.g. TT Intellectual Property Office) before launch.
APP_NAME=Racekit
APP_URL=http://localhost:3000

# 32+ random characters. Used to encrypt sensitive participant data (phone, date of birth, emergency contact, medical notes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Platform fee charged per registration (set lower than competitors). Organizers choose to absorb or pass it on.
PLATFORM_FEE_PERCENT=2.5
PLATFORM_FEE_FIXED_CENTS=200

# Payments: leave blank to disable a provider
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
WIPAY_COUNTRY_CODE=TT

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

FAC_MERCHANT_ID=
FAC_PASSWORD=

# Allow the fake "test card" processor (never enable in production)
PAYMENTS_SANDBOX=1

# Email. If SMTP_HOST is empty, emails are stored in the outbox table and printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Race Registration <no-reply@example.com>"
FAC_API_BASE=https://staging.ptranz.com
PAYPAL_TTD_PER_USD=6.78
